# Backend Environment Variables
# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# --- PostgreSQL connection --------------------------------------------------
# Local dev:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/saharasetu
#   DATABASE_SSL=false
#
# Supabase (TLS required — keep DATABASE_SSL=true):
#   1. Dashboard -> Project Settings -> Database -> Connection string -> URI
#   2. Copy the password and URL-encode it if it has special characters
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Supabase project (optional: for PostgREST/Auth/JWKS, not for pg) ------
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Server -----------------------------------------------------------------
PORT=4000

# --- WhatsApp (Twilio) -------------------------------------------------------
# Twilio replaced the Meta Cloud API: the Meta test WABA's sender is BANNED, so
# sends returned 200 "accepted" and were never delivered.
#
# Credentials: Twilio Console -> account home. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sandbox sender. Confirm the number shown in
# Messaging -> Try it out -> WhatsApp; it is not the number Twilio displays for
# SMS. Recipients must text "join <keyword>" to this number once before they
# can receive anything, and the keyword expires after ~72h of inactivity.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Country code used to expand bare 10-digit vendor numbers into E.164.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# true = log the outbound request instead of sending. Set true whenever the
# sender is unverified — a 2xx alone does NOT mean delivery.
WHATSAPP_DRY_RUN=false
# Status callback URL to configure on the sender (needs a public HTTPS host,
# e.g. `ngrok http 4000`): Messaging -> Senders -> Status callback URL
# TWILIO_STATUS_CALLBACK_URL=https://example.ngrok-free.app/api/whatsapp/status

# --- Document intelligence --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Voice agent ------------------------------------------------------------
VOICE_AGENT_URL=http://localhost:3000

# --- Guardrails Config ------------------------------------------------------
MAX_PAYMENT_AMOUNT=500
MAX_CALL_RETRIES=2
