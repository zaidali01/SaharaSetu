# Backend Environment Variables
# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# --- PostgreSQL connection --------------------------------------------------
# Local dev:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/saharasetu
#   DATABASE_SSL=false
#
# Supabase (TLS required — keep DATABASE_SSL=true):
#   1. Dashboard -> Project Settings -> Database -> Connection string -> URI
#   2. Copy the password and URL-encode it if it has special characters
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Supabase project (optional: for PostgREST/Auth/JWKS, not for pg) ------
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Server -----------------------------------------------------------------
PORT=4000

# --- WhatsApp Business API --------------------------------------------------
# whatsapp.js reads WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Language code of the APPROVED `order_confirmation` template in Meta.
# Use `hi` for the Hindi demo flow (docs/demo_scenario.md).
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# true = log the outbound request instead of sending (useful pre-approval).
WHATSAPP_DRY_RUN=false
WHATSAPP_VERIFY_TOKEN=sahara_setu_secret_token_123

# --- Document intelligence --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Voice agent ------------------------------------------------------------
VOICE_AGENT_URL=http://localhost:3000

# --- Guardrails Config ------------------------------------------------------
MAX_PAYMENT_AMOUNT=500
MAX_CALL_RETRIES=2
