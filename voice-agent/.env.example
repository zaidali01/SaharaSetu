# Copy this file to .env and fill in real values. Never commit .env itself.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
PARENT_TEST_NUMBER=+919430483115

SARVAM_API_KEY=your_sarvam_key_here

# Set this to your ngrok https URL (no trailing slash), e.g. https://abcd1234.ngrok-free.app
# Get it by running: ngrok http 3000
PUBLIC_BASE_URL=

PORT=3000

# Optional — once Person 3's backend has a real alert endpoint, set this and
# escalate.js will POST there automatically in addition to logging locally.
BACKEND_ALERT_URL=

CHILD_NAME=Beta
CHEMIST_NAME=Sharma Medical
DAYS_LEFT=4

# Where the voice agent reports call outcomes (task 2.4i).
# Real backend: http://localhost:4000/api/calls/outcome
# Dev stub (node dev_outcome_stub.js): http://localhost:4001/api/calls/outcome
BACKEND_OUTCOME_URL=http://localhost:4000/api/calls/outcome

# TEST ONLY — Twilio trial can only dial verified numbers. If set, every call
# goes here regardless of the parent phone in the DB. Leave blank for the
# real demo once the account is upgraded / real parent numbers are seeded.
FORCE_DIAL_NUMBER=
